# ==========================================
# 吉林大学图书馆预约助手 - .gitignore
# ==========================================

# ---------- 环境变量（敏感信息，绝对不能提交）----------
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.development
frontend/.env.production

# 但保留示例文件，方便他人配置
!.env.example
!backend/.env.example
!frontend/.env.example

# ---------- 配置文件（可能含敏感信息）----------
backend/config.json

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 虚拟环境
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/

# Python 测试/覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ---------- Node / 前端 (frontend) ----------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.vite.config.js.timestamp-*
frontend/.vite.config.ts.timestamp-*

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 包管理器锁文件（按需保留，通常建议提交 lock 文件，这里不忽略）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ---------- 构建产物 ----------
dist/
build/
*.local

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 ----------
logs/
*.log

# ---------- 其他 ----------
# 临时文件
*.tmp
*.temp
.cache/