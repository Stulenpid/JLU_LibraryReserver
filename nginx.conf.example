worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
    multi_accept on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # 日志格式
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    # 基础性能优化
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    server_tokens off;

    # Gzip 压缩
    gzip on;
    gzip_min_length 1k;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/json
               application/javascript application/x-javascript
               application/xml application/rss+xml image/svg+xml;
    gzip_vary on;
    gzip_disable "MSIE [1-6]\.";

    # 请求体大小限制
    client_max_body_size 20m;
    client_body_buffer_size 128k;

    server {
        listen 80;
        server_name localhost;

        root /usr/share/nginx/html;
        index index.html index.htm;

        # 静态资源缓存
        location ~* \.(jpg|jpeg|png|gif|ico|css|js|woff2?|ttf|svg)$ {
            expires 7d;
            add_header Cache-Control "public, no-transform";
        }

        # 图书馆预约面板（子路径 SPA，静态资源位于 /usr/share/nginx/html/reserve）
        location /reserve/ {
            alias /usr/share/nginx/html/reserve/;
            try_files $uri $uri/ /reserve/index.html;
        }

        # 注意：必须放在 /api/ 之前，nginx 按最长前缀匹配优先命中此块
        # 后端路由本身是 /logs/stream（不带 /api 前缀），故此处剥离前缀转发
        location /api/logs/stream {
            proxy_pass http://127.0.0.1:8010/logs/stream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            # 关缓冲：不攒够 buffer 不发，SSE 会被整段延迟
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_cache off;

            # 关压缩：gzip 为了凑压缩块同样会攒数据
            # （http 段的 gzip_types 虽未含 text/event-stream，这里显式关掉更保险）
            gzip off;

            # 切勿加 chunked_transfer_encoding off：
            # 那是给 HTTP/1.0 上游用的，在 1.1 下会去掉分块边界，
            # 导致 nginx 无法逐段下发，日志表现为"攒一批才刷新"。

            proxy_connect_timeout 10s;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        # 预约面板后端接口反向代理（前后端同容器，走本机端口）
        # 后端路由均不带 /api 前缀（如 /reservations、/logs、/guard），
        # proxy_pass 末尾的 "/" 会让 nginx 剥离掉 location 匹配到的 /api/ 前缀，
        # 例如 /api/config/schema -> 转发给后端 /config/schema
        location /api/ {
            proxy_pass http://127.0.0.1:8010/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_connect_timeout 10s;
            proxy_read_timeout 60s;
        }

        # 主路由（适用于 SPA 单页应用）
        location / {
            try_files $uri $uri/ /index.html;
        }

        # 健康检查接口
        location /health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        # 禁止访问隐藏文件
        location ~ /\. {
            deny all;
            access_log off;
            log_not_found off;
        }

        # 错误页
        error_page 404 /404.html;
        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
        }
    }
}
